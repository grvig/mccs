{
	"schemaVersion": 1,
	"id": "sourcemovement",
	"version": "${version}",
	"name": "Source Movement",
	"description": "Replaces the local player's walking, jumping and air movement with CS:GO style Source engine movement.",
	"authors": [
		"grvig"
	],
	"contact": {
		"sources": "https://github.com/grvig/mccs"
	},
	"license": "MIT",
	"icon": "assets/sourcemovement/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.grvig.sourcemovement.client.SourceMovementClient"
		],
		"modmenu": [
			"com.grvig.sourcemovement.client.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "sourcemovement.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
